{
  "name": "dsh-voice-unified",
  "version": "1.5.7",
  "description": "DSH 统一声音插件：多音色克隆与进化、按需语音回复、七种情感 TTS、翻唱换声直出、音乐缓存联动与管理界面。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "engine",
    "scripts",
    "bin/ffmpeg.exe",
    "bin/ffprobe.exe",
    "docs",
    "examples",
    "tests",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "LICENSE",
    "NOTICE-ffmpeg.txt"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "tts",
    "voice-clone",
    "cover",
    "music"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "license": "MIT"
}
